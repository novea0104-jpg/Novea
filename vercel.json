{
  "buildCommand": "echo 'Using pre-built static files'",
  "outputDirectory": "static-build",
  "installCommand": "echo 'Skipping install'",
  "framework": null,
  "cleanUrls": false,
  "routes": [
    {
      "src": "/.well-known/assetlinks.json",
      "dest": "/.well-known/assetlinks.json",
      "headers": {
        "Content-Type": "application/json",
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "redirects": [],
  "headers": []
}

